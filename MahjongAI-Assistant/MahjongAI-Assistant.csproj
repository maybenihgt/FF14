<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <AssemblyName>MahjongAI-Assistant</AssemblyName>
    <RootNamespace>MahjongAI_Assistant</RootNamespace>
    <Author>Mahjong AI Assistant</Author>
    <Name>Mahjong AI Assistant</Name>
    <Punchline>Lightweight in-game riichi mahjong hand analysis.</Punchline>
    <Description>Manual analysis of a player's own visible hand. No hidden-state reading, automatic inputs, or match manipulation.</Description>
    <Tags>mahjong;analysis;utility</Tags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
